# Copy this file to .env and adjust the values. .env is git-ignored: never commit it.
# Ollama runs locally, so no API keys are needed.

# Ollama model; it must support tool calling (ollama pull gpt-oss)
OLLAMA_MODEL=gpt-oss:latest
# Address of the Ollama server
OLLAMA_HOST=http://127.0.0.1:11434

# Address of the Fruit Shop API that the agent's tools call
FRUIT_SHOP_API_URL=http://127.0.0.1:8000
# SQLite database file of the Fruit Shop API
FRUIT_SHOP_DB=fruits.db
